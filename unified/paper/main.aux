\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The second moments of residual log earnings by family background. Variance in each wave (panel a) and autocovariance by lag, averaged over waves (panel b), for advantaged and less advantaged children, with 95 percent bootstrap intervals (200 clustered replications). Residuals are demeaned within group and year (wave sizes 1,319, 1,049, 2,197, 2,083, and 2,001). Averages over waves weight each wave pair by the inverse of its bootstrap variance. The two curves lie close together at lags zero to three and drift apart at lag four, with overlapping intervals at every lag; the longest lags are where the permanent--transitory split of Table~\ref {tab:md} is decided.}}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:autocov}{{1}{13}{The second moments of residual log earnings by family background. Variance in each wave (panel a) and autocovariance by lag, averaged over waves (panel b), for advantaged and less advantaged children, with 95 percent bootstrap intervals (200 clustered replications). Residuals are demeaned within group and year (wave sizes 1,319, 1,049, 2,197, 2,083, and 2,001). Averages over waves weight each wave pair by the inverse of its bootstrap variance. The two curves lie close together at lags zero to three and drift apart at lag four, with overlapping intervals at every lag; the longest lags are where the permanent--transitory split of Table~\ref {tab:md} is decided}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The identification ridge. Bootstrap draws and point estimates of the fitted $(\rho _v, \text  {permanent share})$ pair for advantaged and less advantaged children, 1,000 clustered replications of the cell-weighted estimator. The row of draws for advantaged children at a share of zero reflects the estimator's boundary constraint ($\sigma ^2_\eta \ge 0$), not a separate mode.}}{13}{figure.caption.5}\protected@file@percent }
\newlabel{fig:ridge}{{2}{13}{The identification ridge. Bootstrap draws and point estimates of the fitted $(\rho _v, \text {permanent share})$ pair for advantaged and less advantaged children, 1,000 clustered replications of the cell-weighted estimator. The row of draws for advantaged children at a share of zero reflects the estimator's boundary constraint ($\sigma ^2_\eta \ge 0$), not a separate mode}{figure.caption.5}{}}
